{
 "$schema":"./node_modules/@angular/cli/lib/config/schema.json","version":1,"newProjectRoot":"projects",
"projects": {
  "crumb-co": {
    "projectType": "application",
    "root": "",
    "sourceRoot": "src",
    "architect": {
      "build": {
        "builder": "@angular-devkit/build-angular:application",
        "options": {
          "outputPath": "dist/crumb-co",
          "index": "src/index.html",
          "browser": "src/main.ts",
          "polyfills": [
            "zone.js"
          ],
          "tsConfig": "tsconfig.app.json",
          "assets": [],
          "styles": [
            "src/styles.css"
          ]
        },
        "configurations": {
          "production": {
            "optimization": true,
            "outputHashing": "all",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "1mb",
                "maximumError": "2mb"
              }
            ]
          },
          "development": {
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          }
        },
        "defaultConfiguration": "production"
      },
      "serve": {
        "builder": "@angular-devkit/build-angular:dev-server",
        "configurations": {
          "production": {
            "buildTarget": "crumb-co:build:production"
          },
          "development": {
            "buildTarget": "crumb-co:build:development"
          }
        },
        "defaultConfiguration": "development"
      }
    }
  }
},
"cli": {
  "analytics": "6bb830ff-6a82-431c-a3f8-280f6454b07d"
}
}
